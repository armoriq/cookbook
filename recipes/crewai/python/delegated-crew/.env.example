# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# The end user the crew acts for. Tokens and audit rows are tagged with it.
USER_EMAIL=developer@armoriq.ai

# Name the incident-ops MCP server is registered under in the ArmorIQ
# dashboard (Platform > MCP Servers) - see README.md
INCIDENT_OPS_MCP_NAME=incident-ops
