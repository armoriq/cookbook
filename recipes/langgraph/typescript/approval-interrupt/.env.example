# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# OpenAI API key (required) - get from https://platform.openai.com/api-keys
# Only the model construction in agent.js depends on this; any LangChain chat
# model with tool calling works.
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4.1-mini

# User email for ArmorIQ session scoping
USER_EMAIL=you@your-org.com

# Name the runbook tools are registered under in the ArmorIQ dashboard
# (Platform > MCP Servers) - see README.md
RUNBOOK_MCP_NAME=oncall-runbook

# How long human_review waits for ArmorIQ to report the decision after resume (seconds)
ARMORIQ_APPROVAL_CONFIRM_SECONDS=30
