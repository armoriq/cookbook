# ArmorIQ API key (required) - get from https://platform.armoriq.ai
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required). Only src/model.mjs uses it. Swap that file for any other
# Strands model and nothing else changes.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# The end user the agent acts for. Tokens, audit rows, and approvals are tagged with it.
USER_EMAIL=developer@armoriq.ai

# Name the support-desk MCP server is registered under in the ArmorIQ console
SUPPORT_DESK_MCP_NAME=support-desk
