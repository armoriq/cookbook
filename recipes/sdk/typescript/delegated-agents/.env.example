# ArmorIQ API key (required) - get from https://platform.armoriq.ai
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required). Only src/model.js uses it, to drive both agents.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# The end user the whole crew acts for. Tokens, audit rows, and approvals are tagged with it.
USER_EMAIL=developer@armoriq.ai

# Name the incident-ops MCP server is registered under in the ArmorIQ console
INCIDENT_OPS_MCP_NAME=incident-ops
