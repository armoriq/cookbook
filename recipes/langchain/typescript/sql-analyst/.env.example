# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
# Only the model construction in agent.js depends on this.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# User email for ArmorIQ session scoping
USER_EMAIL=you@your-org.com

# Name the SQL MCP server is registered under in the ArmorIQ dashboard
# (Platform > MCP Servers) - see README.md
SQL_MCP_NAME=sql-warehouse

# Optional: where the SQLite file lives (default ./analytics.db, built from db/seed.sql)
# ANALYTICS_DB=./analytics.db
