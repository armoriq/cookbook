# Intent Gateway: create a key under Gateway in the ArmorIQ dashboard. It is shown once.
ARMORIQ_GATEWAY_KEY=your_gateway_key_here
# Leave empty for phase 1 (record only). Set to your agent's id for phases 2 and 3.
ARMORIQ_AGENT_ID=
ARMORIQ_GATEWAY_HOST=https://gw.armoriq.ai

# The model key. The gateway forwards it to OpenAI untouched.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# Optional: attributes each request to this person in traces
USER_EMAIL=dana@example.com
